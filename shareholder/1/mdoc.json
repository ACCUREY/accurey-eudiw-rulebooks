{
  "doctype": "com.accurey.shareholder.1",
  "namespace": "com.accurey.shareholder.1",
  "name": "Shareholder status (mdoc)",
  "sd_jwt_vct": "https://vct.accurey.com/shareholder/1",
  "issuer": "https://api.playground.france-identite.gouv.fr/accurey/issue-demo",
  "trust": {
    "iaca_subject": "CN=Accurey IACA, O=ACCUREY, C=LU",
    "document_signer_eku": "1.0.18013.5.1.2",
    "trusted_list": "EUDIW Unfold Trust Management (Interop Week 2026)"
  },
  "validity": { "validUntil": "signed + 48h", "note": "short-lived, re-issued from the register on demand" },
  "elements": [
    { "identifier": "company_name", "type": "tstr", "mandatory": true, "sd_jwt_claim": ["company", "legal_name"], "display": [ { "lang": "en-US", "label": "Company" }, { "lang": "fr-FR", "label": "Société" } ] },
    { "identifier": "company_id", "type": "tstr", "mandatory": true, "sd_jwt_claim": ["company", "identifier", "value"], "display": [ { "lang": "en-US", "label": "Company ID" }, { "lang": "fr-FR", "label": "Identifiant société" } ] },
    { "identifier": "company_id_scheme", "type": "tstr", "mandatory": true, "enum": ["lei", "gb_company_number", "lu_rcs", "sg_uen", "adgm_number", "sa_cr", "fr_siren", "other"], "sd_jwt_claim": ["company", "identifier", "scheme"], "display": [ { "lang": "en-US", "label": "Identifier scheme" } ] },
    { "identifier": "company_jurisdiction", "type": "tstr (ISO 3166-1 alpha-2)", "mandatory": true, "sd_jwt_claim": ["company", "jurisdiction"], "display": [ { "lang": "en-US", "label": "Jurisdiction" }, { "lang": "fr-FR", "label": "Juridiction" } ] },
    { "identifier": "is_shareholder", "type": "bool", "mandatory": true, "sd_jwt_claim": ["is_shareholder"], "display": [ { "lang": "en-US", "label": "Shareholder" }, { "lang": "fr-FR", "label": "Actionnaire" } ] },
    { "identifier": "share_class", "type": "tstr", "mandatory": false, "sd_jwt_claim": ["share_class"], "display": [ { "lang": "en-US", "label": "Share class" }, { "lang": "fr-FR", "label": "Catégorie" } ] },
    { "identifier": "holding_band", "type": "tstr", "mandatory": false, "enum": ["lt_1", "1_to_5", "5_to_10", "10_to_25", "25_to_50", "gte_50"], "sd_jwt_claim": ["holding_band"], "display": [ { "lang": "en-US", "label": "Holding band" }, { "lang": "fr-FR", "label": "Détention" } ] },
    { "identifier": "holding_percentage", "type": "number", "mandatory": false, "sd_jwt_claim": ["holding_percentage"], "display": [ { "lang": "en-US", "label": "Holding %" } ] },
    { "identifier": "share_count", "type": "uint", "mandatory": false, "sd_jwt_claim": ["share_count"], "display": [ { "lang": "en-US", "label": "Shares" } ] },
    { "identifier": "voting_rights", "type": "bool", "mandatory": false, "sd_jwt_claim": ["voting_rights"], "display": [ { "lang": "en-US", "label": "Voting rights" } ] },
    { "identifier": "register_operator", "type": "tstr", "mandatory": false, "sd_jwt_claim": ["register_operator"], "display": [ { "lang": "en-US", "label": "Register operator" } ] },
    { "identifier": "register_as_of", "type": "full-date (tag 1004)", "mandatory": true, "sd_jwt_claim": ["register_as_of"], "note": "SD-JWT carries date-time; mdoc carries the date part", "display": [ { "lang": "en-US", "label": "As of" }, { "lang": "fr-FR", "label": "Arrêté au" } ] },
    { "identifier": "attestation_legal_category", "type": "tstr", "mandatory": true, "enum": ["non_qualified_eaa"], "sd_jwt_claim": ["attestation_legal_category"], "display": [ { "lang": "en-US", "label": "Legal category" } ] },
    { "identifier": "issuing_country", "type": "tstr (ISO 3166-1 alpha-2)", "mandatory": true, "sd_jwt_claim": ["issuing_country"], "display": [ { "lang": "en-US", "label": "Issuing country" } ] }
  ],
  "presentation_profiles": {
    "minimal": ["is_shareholder", "company_name", "company_id", "register_as_of"],
    "band": ["is_shareholder", "company_name", "company_id", "register_as_of", "share_class", "holding_band"],
    "full": ["company_name", "company_id", "company_id_scheme", "company_jurisdiction", "is_shareholder", "share_class", "holding_band", "register_operator", "register_as_of", "attestation_legal_category", "issuing_country"]
  },
  "dcql_example": {
    "credentials": [
      { "id": "acc_shareholder_mdoc", "format": "mso_mdoc", "meta": { "doctype_value": "com.accurey.shareholder.1" },
        "claims": [ { "path": ["com.accurey.shareholder.1", "is_shareholder"] }, { "path": ["com.accurey.shareholder.1", "company_name"] }, { "path": ["com.accurey.shareholder.1", "company_id"] }, { "path": ["com.accurey.shareholder.1", "register_as_of"] } ] },
      { "id": "acc_shareholder_sdjwt", "format": "dc+sd-jwt", "meta": { "vct_values": ["https://vct.accurey.com/shareholder/1"] },
        "claims": [ { "path": ["is_shareholder"] }, { "path": ["company"] }, { "path": ["register_as_of"] } ] }
    ],
    "credential_sets": [ { "options": [ ["acc_shareholder_mdoc"], ["acc_shareholder_sdjwt"] ], "purpose": "Shareholder status verification" } ]
  },
  "oid4vci": {
    "credential_configuration_ids": { "mso_mdoc": "acc_shareholder_mdoc", "dc+sd-jwt": "acc_shareholder_sd_jwt" },
    "grant": "urn:ietf:params:oauth:grant-type:pre-authorized_code (tx_code 4 digits)",
    "proof_types": ["jwt", "attestation"]
  }
}
